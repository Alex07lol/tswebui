# OCR Platform Backend — Environment Configuration
# Copy to .env and edit values

# App
APP_NAME=OCR Platform
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173"]

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./ocr_platform.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ocr_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# OCR
DEFAULT_OCR_PROVIDER=tesseract
TESSERACT_CMD=tesseract
DEFAULT_OCR_LANGUAGE=eng

# Jobs
JOB_BACKEND=inline
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
