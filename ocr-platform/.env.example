# Application
APP_NAME=OCR Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
# For development SQLite:
DATABASE_URL=sqlite+aiosqlite:///./ocr_platform.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://ocr_platform:ocr_platform_dev@postgres:5432/ocr_platform

# Redis (for production job queues and caching)
REDIS_URL=redis://localhost:6379/0

# Security / JWT
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_KEY_AT_LEAST_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# OCR Engine
DEFAULT_OCR_PROVIDER=tesseract
TESSERACT_CMD=tesseract
DEFAULT_OCR_LANGUAGE=eng

# Jobs & Concurrency
JOB_BACKEND=inline
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
